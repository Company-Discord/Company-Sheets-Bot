# Copy to .env.dashboard for local development. Never commit real credentials.
DATABASE_URL=postgresql://user:password@localhost:5432/company
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DASHBOARD_GUILD_ID=
DASHBOARD_URL=http://localhost:8000
# Comma-separated Discord role IDs. Officer actions require a role in this list.
DASHBOARD_OFFICER_ROLE_IDS=
# Only these roles are displayed on profiles; leave blank to hide all role names.
DASHBOARD_VISIBLE_ROLE_IDS=
# Enable /link-character and the self-service AION 2 character commands in the bot.
AION2_DISCORD_COMMANDS=false
AION2_REGION=nae
# Keep false until your actual region/character has been validated.
AION2_IMPORTS_ENABLED=false
